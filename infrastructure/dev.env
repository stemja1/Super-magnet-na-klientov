# Vývojové premenné prostredia (načítava ich backend cez python-dotenv).
# Skopíruj obsah do .env v koreni backendu alebo exportuj pred spustením.

# Backend
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./app.db
REDIS_URL=redis://localhost:6379/0
LLM_MODEL_PATH=
LLM_GPU_LAYERS=-1
JWT_SECRET=change-me-in-production

# Frontend (Vite / Tauri)
VITE_API_BASE=http://localhost:8000
