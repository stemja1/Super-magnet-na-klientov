# Vývojové premenné prostredia.
# Skopíruj do `backend/.env` (načíta ho python-dotenv) alebo ich exportuj pred spustením.

# Backend
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./app.db
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
LLM_MODEL_PATH=
LLM_GPU_LAYERS=-1

# --- Auth ---
# V development môže zostať prázdne (vygeneruje sa dočasný secret a tokeny po
# reštarte neplatia). Pre APP_ENV=production JE POVINNÝ — aplikácia odmietne
# naštartovať s prázdnym alebo placeholder hodnotou.
# Generovanie: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Obmedzenie neúspešných prihlásení (per používateľ + IP) — ochrana pred hrubou silou
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- CORS ---
# `*` je zámerne odmietnuté: API posiela Authorization hlavičku a prehliadače
# kombináciu wildcard + credentials odmietajú. Vypíš explicitné pôvod.
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420

# Frontend (Vite / Tauri)
VITE_API_BASE=http://localhost:8000
